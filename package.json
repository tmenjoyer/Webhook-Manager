{
  "name": "webhook-manager",
  "version": "1.1.4",
  "license": "MIT",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bunx serve out",
    "lint": "biome check",
    "format": "biome format --write",
    "build:web": "next build",
    "electron:dev": "electron .",
    "electron:build": "next build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@next/third-parties": "16.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "oxc-resolver",
    "unrs-resolver"
  ],
  "description": "Discord webhook personalizer, message sender and deleter.",
  "author": "tmenjoyer",
  "homepage": "https://github.com/tmenjoyer/webhook-manager",
  "main": "electron/main.js",
  "build": {
    "appId": "com.tmenjoyer.webhookmanager",
    "productName": "Webhook Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "public/logo.png",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "public/logo.png"
    },
    "portable": {
      "artifactName": "Webhook-Manager.exe"
    }
  }
}
